# Python Code Sandbox MCP Configuration

# [Required for Caching] Path on your HOST machine to persist pip packages
# Example (Windows): C:\Users\yourname\.mcp-cache\pip
# Example (Linux/Mac): /Users/yourname/.mcp-cache/pip
PIP_CACHE_PATH=

# Enable/Disable pip cache (true/false)
ENABLE_PIP_CACHE=true

# Sandbox Resource Limits
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_CPU_PERIOD=100000
SANDBOX_CPU_QUOTA=50000

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
